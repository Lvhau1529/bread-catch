{
  "name": "phonics-arcade",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Phonics Arcade — classroom phonics games (Bread Catcher, Food Stream) built with Phaser 3 + React",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:bread": "python tools/bread_catcher/build_sprites.py",
    "assets:food-stream": "python tools/food_stream/build_sprites.py",
    "assets:audio": "python tools/build_audio.py",
    "assets:icons": "python tools/build_app_icons.py",
    "assets:ui": "python tools/arcade_ui/build_ui.py",
    "assets": "pnpm run assets:bread && pnpm run assets:food-stream && pnpm run assets:ui && pnpm run assets:audio && pnpm run assets:icons"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "phaser": "^3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
