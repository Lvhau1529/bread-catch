{
  "name": "bread-catcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bread Catcher — cozy pixel-art catching game built with Phaser 3",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:sprites": "python tools/build_sprites.py",
    "assets:audio": "python tools/build_audio.py",
    "assets": "npm run assets:sprites && npm run assets:audio"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
